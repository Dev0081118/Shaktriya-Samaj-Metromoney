PORT=3001
NODE_ENV=development

MONGO_URI=mongodb://127.0.0.1:27017/kshatriya_matrimonial

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:5173

LEGAL_VERSION=development-draft
LEGAL_EFFECTIVE_DATE=

# OTP
OTP_PROVIDER=development

OTP_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# Media
MEDIA_PROVIDER=cloudinary

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email
# Supported:
# development
# gmail
# resend
EMAIL_PROVIDER=development

EMAIL_FROM=
EMAIL_REPLY_TO=

# Gmail API OAuth2
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=

# Optional Resend fallback
RESEND_API_KEY=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=