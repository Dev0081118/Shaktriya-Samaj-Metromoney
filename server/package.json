{
  "name": "kshatriya-matrimonial-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "seed": "node src/seed.js",
    "subscriptions:expire": "node src/scripts/checkSubscriptions.js",
    "plans:setup": "node src/scripts/setupMembershipPlans.js",
    "admin:create": "node src/scripts/createSuperAdmin.js",
    "check": "find src -name '*.js' -exec node --check {} + && node --check server.js && NODE_ENV=test JWT_SECRET=test-secret node -e \"import('./src/app.js')\"",
    "test": "node --test"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^9.0.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.0"
  }
}
